{
  "tasks": {
    "dev": "deno run -A --watch ./src/default/lib.ts",
    "update": "deno outdated --update --latest",
    "build": "deno run -A scripts/build.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "typescript": "npm:typescript@^6.0.2"
  },
  "compilerOptions": {
    // From @tsconfig/strictest
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "checkJs": true,
    "lib": ["deno.window", "deno.worker" /*, "deno.unstable"*/]
  },
  "lint": {
    "rules": {
      "include": [],
      "exclude": ["no-explicit-any", "no-unused-vars"]
    }
  }
  // "unstable": ["raw-imports", "worker-options", "cron"]
}
